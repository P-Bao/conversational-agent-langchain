# ============================================================
# Conversational Agent LangChain — Template .env (v7 Remote)
# Repo là retrieval-only; embedding + rerank delegate tới HTTP endpoint
# ngoài (Colab ngrok / server GPU riêng). Copy sang .env và điền giá trị.
# Xem notebook: rag_test_bge_m3_reranker_ngrok.ipynb
# ============================================================

# === Dense embedding (remote BGE-m3) ===
EMBEDDING_PROVIDER=remote
EMBEDDING_BASE_URL=https://xxxx.ngrok-free.app
# EMBEDDING_TIMEOUT=60

# === Retrieval ===
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# === Reranker (optional; default 'none' = passthrough, 'remote' = BGE-reranker-v2-m3 qua HTTP) ===
RERANK_PROVIDER=none
RERANK_BASE_URL=https://xxxx.ngrok-free.app
RERANK_TOP_K=5
# RERANK_TIMEOUT=60

# === Qdrant (managed externally — only URL + collection here) ===
QDRANT_URL=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# === NVIDIA NIM eval LLM (DeepEval test only) ===
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_EVAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EVAL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EVAL_RPS=30

# === Qwen self-host eval LLM (DeepEval test only) ===
QWEN_EVAL_BASE_URL=http://localhost:8000/v1
QWEN_EVAL_API_KEY=
QWEN_EVAL_MODEL=qwen
