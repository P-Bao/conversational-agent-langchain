# ============================================================
# Conversational Agent LangChain — Template .env (v6 Retrieval-only)
# Copy to .env và điền các giá trị phù hợp
# ============================================================

# === Dense embedding (BGE-m3) ===
AU_EMBED_MODEL_NAME=BAAI/bge-m3
AU_EMBED_DIMENSION=1024
EMBEDDING_PROVIDER=bge

# === Sparse embedding (BGE-m3 lexical weights) ===
AU_SPARSE_MODEL_NAME=BAAI/bge-m3

# === Retrieval ===
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# === Reranker (BGE-reranker v2-m3) ===
RERANK_PROVIDER=bge
AU_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# === Hybrid Fusion (rrf hoặc dbsf) ===
FUSION_ALGORITHM=rrf

# === Qdrant ===
QDRANT_URL=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# === NVIDIA NIM eval LLM (DeepEval) ===
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_EVAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EVAL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EVAL_RPS=30

# === Qwen self-host eval LLM (DeepEval) ===
QWEN_EVAL_BASE_URL=http://localhost:8000/v1
QWEN_EVAL_API_KEY=
QWEN_EVAL_MODEL=qwen
QWEN_EVAL_THINKING=false

# === DeepEval Rate Limit (chỉ cho Eval LLM, RAG system local không rate-limit) ===
EVAL_RPM=13
EVAL_TPM=40000

# === Backward-compat ===
COHERE_API_KEY=
OPENAI_API_KEY=
