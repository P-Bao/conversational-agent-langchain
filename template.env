# Gemini API (REQUIRED)
GEMINI_API_KEY=

# Generation Model (Gemini via LiteLLM)
GENERATION_MODEL=gemini/gemini-2.5-flash

# Embedding Model (Gemini embedding)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_SIZE=768

# Vector Database - Qdrant Docker (no authen, matches qdrant_docker default config)
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=default

# Tracing - Phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Reranking - DISABLED (using RRF via Qdrant Hybrid search)
RERANK_PROVIDER=none

# Retrieval
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# Hybrid fusion (Qdrant): "rrf" (Reciprocal Rank Fusion, default) or "dbsf" (Distribution-Based Score Fusion)
FUSION_ALGORITHM=rrf
# Reserved for future use (qdrant-client SDK does not expose these today; kept for documentation).
RRF_K=60
DBSF_WINDOW=1000