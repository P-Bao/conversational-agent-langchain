# ============================================================
# Conversational Agent LangChain — Template .env (v7 Retrieval & Search)
# Repo is retrieval-only; Qdrant collection management is delegated to an
# external system. Copy to .env and fill values as needed.
# ============================================================

# === Dense embedding (BGE-m3) ===
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_SIZE=1024

# === Sparse embedding (BGE-m3 lexical weights) ===
SPARSE_MODEL=BAAI/bge-m3

# === Retrieval ===
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# === Reranker (optional; default 'none' = no rerank, passthrough) ===
RERANK_PROVIDER=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=5

# === Hybrid Fusion (rrf hoặc dbsf) ===
FUSION_ALGORITHM=rrf

# === Qdrant (managed externally — only URL + collection here) ===
QDRANT_URL=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# === NVIDIA NIM eval LLM (DeepEval test only) ===
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_EVAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EVAL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EVAL_RPS=30

# === Qwen self-host eval LLM (DeepEval test only) ===
QWEN_EVAL_BASE_URL=http://localhost:8000/v1
QWEN_EVAL_API_KEY=
QWEN_EVAL_MODEL=qwen
QWEN_EVAL_THINKING=false

# === Backward-compat (no-op) ===
COHERE_API_KEY=
OPENAI_API_KEY=

