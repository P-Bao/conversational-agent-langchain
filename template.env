# ============================================================
# Conversational Agent LangChain — Template .env (v8 Local Reranker + Embedding Server)
# Repo là retrieval-only; embedding delegate tới external HTTP endpoint
# (embedding-server container), rerank chạy local qua FlagEmbedding.
# Copy sang .env và điền giá trị.
# Xem notebook: rag_test_bge_m3_reranker_ngrok.ipynb
# ============================================================

# === Dense embedding (remote BGE-m3 via embedding-server) ===
# Hostname = tên service trong docker-compose của embedding-server.
# Port 8005 (mapping mới). Cùng network Docker để gọi được bằng hostname.
EMBEDDING_PROVIDER=remote
EMBEDDING_BASE_URL=http://bge-m3-embed:8005
# API key trùng với BGE_API_KEY trong embedding-server/.env
# (embedding-server verify header: "Authorization: Bearer <key>").
# Để trống nếu embedding-server không bật auth (BGE_API_KEY trống).
EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT=60

# === Retrieval ===
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# === Reranker (local BGE-reranker-v2-m3 via FlagEmbedding) ===
RERANK_PROVIDER=bge
RERANK_TOP_K=5
# RERANK_BASE_URL removed (runs local, env tách sang config.rerank_model)

# === Qdrant (managed externally — only URL + collection here) ===
QDRANT_URL=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# === NVIDIA NIM eval LLM (DeepEval test only) ===
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_EVAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EVAL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EVAL_RPS=30

# === Qwen self-host eval LLM (DeepEval test only) ===
QWEN_EVAL_BASE_URL=http://localhost:8000/v1
QWEN_EVAL_API_KEY=
QWEN_EVAL_MODEL=qwen
