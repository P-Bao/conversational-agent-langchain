# ============================================================
# Conversational Agent LangChain — Template .env (v8.1 Remote Reranker + Embedding Server)
# Repo là retrieval-only; embedding delegate tới external HTTP endpoint
# (embedding-server container :8008), rerank default remote qua HTTP
# (rerank-server :8010). `bge` local (FlagEmbedding) giữ làm fallback (cần GPU).
# Copy sang .env và điền giá trị.
# ============================================================

# === Dense + Sparse embedding (remote BGE-m3 via embedding-server :8008) ===
# Hostname = tên service trong docker-compose của embedding-server.
# Port 8008 (embedding-server expose). Cùng network Docker để gọi được bằng hostname.
EMBEDDING_PROVIDER=remote
EMBEDDING_BASE_URL=http://bge-m3-embed:8008
# API key trùng với BGE_API_KEY trong embedding-server/.env
# (embedding-server verify header: "Authorization: Bearer <key>").
# Để trống nếu embedding-server không bật auth (BGE_API_KEY trống).
EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT=60

# === Retrieval ===
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# === Reranker (mặc định remote qua rerank-server :8010) ===
# Provider:
#   remote (default) -> HTTP tới RERANK_BASE_URL (rerank-server, vd http://127.0.0.1:8010)
#                       Contract: POST /rerank {query, documents, top_k}
#                                  -> {scores: [...], ranked_indices: [...]}
#                       Fail-fast: server lỗi -> API raise (không auto-fallback).
#   bge              -> local FlagEmbedding fallback (cần GPU trong container, ~2.2GB RAM)
#   none             -> passthrough docs[:top_k] (không rerank)
RERANK_PROVIDER=remote
# Bắt buộc điền khi RERANK_PROVIDER=remote. Ví dụ:
#   - Host GPU local:  http://127.0.0.1:8010
#   - Docker -> host:  http://host.docker.internal:8010
#   - Cùng network:    http://rerank-server:8010
RERANK_BASE_URL=
RERANK_TOP_K=5
# RERANK_TIMEOUT=60
# Chỉ dùng khi RERANK_PROVIDER=bge:
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# === Qdrant (managed externally — only URL + collection here) ===
QDRANT_URL=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# === NVIDIA NIM eval LLM (DeepEval test only) ===
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_EVAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EVAL_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EVAL_RPS=30

# === Qwen self-host eval LLM (DeepEval test only) ===
QWEN_EVAL_BASE_URL=http://localhost:8000/v1
QWEN_EVAL_API_KEY=
QWEN_EVAL_MODEL=qwen
