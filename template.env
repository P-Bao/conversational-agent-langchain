# ============================================================
# Conversational Agent LangChain — Template .env
# Copy to .env và điền các giá trị phù hợp
# ============================================================

# === Gemini API (bắt buộc cho embedding + generation) ===
GEMINI_API_KEY=

# === Generation Model ===
GENERATION_MODEL=gemini/gemini-2.5-flash

# === Embedding Model (phải khớp vector size với Qdrant collection) ===
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-002
EMBEDDING_SIZE=3072

# === OpenAI-compatible LLM (optional — chỉ dùng khi không dùng Gemini trực tiếp) ===
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# === Custom Embedding endpoint (optional — override nếu dùng provider khác) ===
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# === Retrieval (tinh chỉnh cho số lượng documents) ===
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# === Reranker (mặc định none, chọn "flashrank" hoặc "cohere" để bật) ===
RERANK_PROVIDER=none
RERANK_TOP_K=5
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# === Hybrid Fusion (rrf hoặc dbsf) ===
FUSION_ALGORITHM=rrf

# === Qdrant (kết nối qua shared qdrant_docker) ===
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# === Tracing (Phoenix) ===
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# === DeepEval — Eval LLM (model đổi qua env này, API key dùng GEMINI_API_KEY hoặc EVAL_LLM_API_KEY) ===
EVAL_LLM_MODEL=gemini/gemini-2.5-flash
EVAL_LLM_API_KEY=

# === DeepEval — Rate Limits (cho cả RAG gen + eval LLM) ===
# RPM=13 → tối đa 13 request/phút mỗi model
# 14 test × (1 RAG + 4 eval) = 14 RAG + 56 eval → cần ~5-6 phút để hoàn tất
RAG_GEN_RPM=13
RAG_GEN_TPM=16000
RAG_EMBED_RPM=13
RAG_EMBED_TPM=30000
EVAL_RPM=13
EVAL_TPM=40000

# Sleep giữa các test case (giây) — giúp tránh burst, cooldown cho rate limit
TEST_CASE_COOLDOWN=0

# === Backward-compat (giữ nguyên cho các script cũ) ===
COHERE_API_KEY=
OPENAI_API_KEY=
