# Environment variables for deepeval tests
# Usage: cp env.test .env.test && edit .env.test with real keys

# Gemini API (REQUIRED - for RAG system under test)
GEMINI_API_KEY=

# Generation Model (Gemini via LiteLLM) - system under test
GENERATION_MODEL=gemini/gemini-2.5-flash

# Embedding Model (Gemini embedding)
EMBEDDING_MODEL=gemini-embedding-002
EMBEDDING_SIZE=768

# Qdrant
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Tracing
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Reranking - DISABLED
RERANK_PROVIDER=none

# Retrieval
RETRIEVAL_K=40
RETRIEVAL_K_RETRY=100

# Hybrid fusion (Qdrant): "rrf" (default) or "dbsf"
FUSION_ALGORITHM=rrf
RRF_K=60
DBSF_WINDOW=1000

# === DeepEval LLM (NVIDIA NIM - evaluation model) ===
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
EVAL_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Fallback LLM vars (used if EVAL_LLM_* not set)
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_BASE_URL=

# === Rate Limits ===
EVAL_RPM=30
EVAL_TPM=0
RAG_GEN_RPM=30
RAG_GEN_TPM=16000
RAG_EMBED_RPM=100
RAG_EMBED_TPM=30000