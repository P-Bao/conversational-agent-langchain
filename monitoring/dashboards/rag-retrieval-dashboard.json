          },
          "description": "Drilldown theo ngày / giờ — bấm vào 1 cột ngày để xem chi tiết theo giờ, giống panel TTS/STT theo ngày/giờ của chirp3-metrics.",
          "id": 2,
          "links": [],
          "title": "Requests theo ngày / giờ",
          "vizConfig": {
            "group": "volkovlabs-echarts-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "baidu": {
                  "callback": "bmapReady",
                  "key": ""
                },
                "editor": {
                  "format": "auto"
                },
                "editorMode": "code",
                "gaode": {
                  "key": "",
                  "plugin": "AMap.Scale,AMap.ToolBar"
                },
                "getOption": "const selectedDay = context.grafana.replaceVariables('$selected_day');\n\nfunction getSeries(refId, labelKey) {\n  const frames = context.panel.data.series.filter((s) => s.refId === refId);\n  const points = frames.map((frame) => {\n    const valueField = frame.fields.find((f) => f.type === 'number');\n    const label = (valueField && valueField.labels && valueField.labels[labelKey]) || '';\n    const values = valueField ? valueField.values.toArray() : [0];\n    return { label: label, value: values[values.length - 1] || 0 };\n  }).filter((p) => p.label !== '');\n  points.sort((a, b) => a.label.localeCompare(b.label));\n  return points;\n}\n\nfunction backButton(onClick) {\n  const W = 190, H = 34;\n  const BTN_COLOR = '#374151';\n  return {\n    elements: [\n      {\n        type: 'group',\n        right: 10,\n        top: 4,\n        z: 100,\n        children: [\n          {\n            type: 'rect',\n            shape: { x: 0, y: 0, width: W, height: H, r: 6 },\n            style: { fill: BTN_COLOR },\n            onclick: onClick,\n            cursor: 'pointer'\n          },\n          {\n            type: 'text',\n            x: W / 2,\n            y: H / 2,\n            style: {\n              text: '← Quay lại theo ngày',\n              fill: '#ffffff',\n              fontSize: 13,\n              fontWeight: 'bold',\n              align: 'center',\n              verticalAlign: 'middle'\n            },\n            onclick: onClick,\n            cursor: 'pointer'\n          }\n        ]\n      }\n    ]\n  };\n}\n\nconst MS_PER_DAY = 24 * 60 * 60 * 1000;\nconst MIN_DAYS = 7;\n\nfunction toDateLabel(ms) {\n  const d = new Date(ms);\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  return y + '-' + m + '-' + day;\n}\n\nlet option;\n\nif (!selectedDay) {\n  // ---- VIEW THEO NGÀY: luôn hiển thị tối thiểu 7 ngày, mở rộng nếu time range dài hơn ----\n  const fromMs = Number(context.grafana.replaceVariables('$__from'));\n  const toMsRaw = Number(context.grafana.replaceVariables('$__to'));\n  const toMs = new Date(toDateLabel(toMsRaw) + 'T00:00:00').getTime();\n\n  const valueByDay = {};\n  getSeries('A', 'day').forEach((p) => { valueByDay[p.label] = p.value; });\n\n  const rangeDays = Math.round((toMs - new Date(toDateLabel(fromMs) + 'T00:00:00').getTime()) / MS_PER_DAY) + 1;\n  const daysToShow = Math.max(MIN_DAYS, rangeDays);\n\n  const points = [];\n  for (let i = daysToShow - 1; i >= 0; i--) {\n    const label = toDateLabel(toMs - i * MS_PER_DAY);\n    points.push({ label: label, value: valueByDay[label] || 0 });\n  }\n\n  option = {\n    tooltip: {\n      trigger: 'axis',\n      axisPointer: { type: 'shadow' },\n      formatter: (params) => {\n        const p = params[0];\n        return 'Ngày ' + p.axisValueLabel + '<br/>Số request: <b>' + p.value + '</b>';\n      }\n    },\n    grid: { left: 55, right: 30, top: 30, bottom: 40, containLabel: true },\n    xAxis: { type: 'category', data: points.map((p) => p.label) },\n    yAxis: { type: 'value' },\n    series: [{\n      type: 'bar',\n      data: points.map((p) => p.value),\n      barCategoryGap: '35%',\n      label: { show: true, position: 'top', fontSize: 11 },\n      itemStyle: { color: '#73C0DE', borderRadius: [4, 4, 0, 0] }\n    }]\n  };\n  context.panel.chart.off('click');\n  context.panel.chart.on('click', (params) => {\n    const day = points[params.dataIndex] && points[params.dataIndex].label;\n    if (day) {\n      context.grafana.locationService.partial({ 'var-selected_day': day }, true);\n    }\n  });\n} else {\n  // ---- VIEW THEO GIỜ: đủ 24 giờ của ngày đã chọn, mỗi giờ 1 cột riêng biệt ----\n  const raw = getSeries('B', 'hod');\n  const byHour = {};\n  raw.forEach((p) => { byHour[p.label] = p.value; });\n  const hours = Array.from({ length: 24 }, (_, h) => String(h).padStart(2, '0'));\n  const values = hours.map((h) => byHour[h] || 0);\n\n  const maxHourVal = Math.max(...values, 1);\n  option = {\n    tooltip: {\n      trigger: 'axis',\n      axisPointer: { type: 'shadow' },\n      formatter: (params) => {\n        const p = params[0];\n        return 'Giờ ' + p.axisValueLabel + '<br/>Số request: <b>' + p.value + '</b>';\n      }\n    },\n    grid: { left: 55, right: 30, top: 55, bottom: 40, containLabel: true },\n    graphic: backButton(() => context.grafana.locationService.partial({ 'var-selected_day': '' }, true)),\n    xAxis: { type: 'category', data: hours.map((h) => h + 'h') },\n    yAxis: { type: 'value', max: Math.ceil(maxHourVal * 1.25) },\n    series: [{\n      type: 'bar',\n      data: values,\n      barCategoryGap: '25%',\n      label: { show: true, position: 'top', fontSize: 11 },\n      itemStyle: { color: '#FAC858', borderRadius: [4, 4, 0, 0] }\n    }]\n  };\n}\n\nreturn option;\n",
                "google": {
                  "callback": "gmapReady",
                  "key": ""
                },
                "map": "none",
                "renderer": "canvas",
                "themeEditor": {
                  "config": "{}",
                  "name": "default"
                },
                "visualEditor": {
                  "code": "return {\n  dataset: context.editor.dataset,\n  series: context.editor.series,\n  xAxis: {\n    type: 'time',\n  },\n  yAxis: {\n    type: 'value',\n    min: 'dataMin',\n  },\n}\n",
                  "dataset": [],
                  "series": []
                }
              }
            },
            "version": "7.2.5"
          }
        }
      },
