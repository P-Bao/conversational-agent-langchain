    {
      "id": 2,
      "title": "Requests by Day / Hour (Asia/Ho_Chi_Minh)",
      "type": "volkovlabs-echarts-panel",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (day) (rag_retrieval_requests_by_day_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{day}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum by (hod) (rag_retrieval_requests_by_day_hour_total{day=\"$selected_day\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{hod}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "editor": {
          "format": "auto",
          "language": "javascript"
        },
        "getOption": "// Requests by Day / Hour — day distribution + hourly pattern of $selected_day.\n// data[0]: query A  = sum by (day)  (all days in range)\n// data[1]: query B  = sum by (hod)  for the selected day (template var selected_day)\n// Instant queries: each labeled series is one field; field.name = legend\n// (set to {{day}} / {{hod}}), field.values = samples over the range.\nconst toPairs = (frame) => {\n  if (!frame || !frame.fields) return [];\n  return frame.fields\n    .filter((f) => f.name !== 'Time')\n    .map((f) => ({ name: f.name, value: f.values[f.values.length - 1] }))\n    .filter((p) => p.value != null && !Number.isNaN(p.value));\n};\n\nconst dayPairs = toPairs(data[0]);\nconst hodPairs = toPairs(data[1]);\n\ndayPairs.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));\nhodPairs.sort((a, b) => parseInt(a.name, 10) - parseInt(b.name, 10));\n\nreturn {\n  tooltip: { trigger: 'axis' },\n  legend: { data: ['day', 'hour'] },\n  grid: [\n    { left: 50, right: 20, top: 32, height: '34%' },\n    { left: 50, right: 20, top: '58%', bottom: 30 },\n  ],\n  xAxis: [\n    { type: 'category', name: 'day', gridIndex: 0, data: dayPairs.map((p) => p.name) },\n    { type: 'category', name: 'hour of day ($selected_day)', gridIndex: 1, data: hodPairs.map((p) => p.name) },\n  ],\n  yAxis: [\n    { type: 'value', name: 'requests', gridIndex: 0 },\n    { type: 'value', name: 'requests', gridIndex: 1 },\n  ],\n  series: [\n    { name: 'day', type: 'bar', xAxisIndex: 0, yAxisIndex: 0, data: dayPairs.map((p) => p.value), itemStyle: { color: '#73C0DE' } },\n    { name: 'hour', type: 'bar', xAxisIndex: 1, yAxisIndex: 1, data: hodPairs.map((p) => p.value), itemStyle: { color: '#FAC858' } },\n  ],\n};"
      }
    },
